{% extends "layout.njk" %}

{% set pageName = "Analysis Board" %}

{% block style %}
<link rel="stylesheet" href="{{ manifest['css/game.css'] }}" />
<link rel="stylesheet" href="{{ manifest['css/gameSetupModal.css'] }}" />
<link rel="stylesheet" href="{{ manifest['css/analysis.css'] }}" />
{% endblock %}

{% block head %}
{# SSR→client channel: optional game id to auto-load, plus the hashed engine-worker
   asset URL (workers can't resolve the manifest themselves) and the runtime-copied
   multithreaded engine package location. #}
<script>window.analysisPageData = {
	gameId: {{ gameId | json | safe }},
	workerUrl: "{{ manifest['scripts/esm/views/analysis/hydrochessanalysis.worker.ts'] }}"
};</script>
<script>window.t = Object.assign(window.t || {}, { index: {{ scriptT('index') | json | safe }} });</script>
{% endblock %}

{% block body %}
{% include "components/header/header.njk" %}
{% from "components/user.njk" import usernameEmbed %}
{% from "components/gameSetupModal.njk" import gameSetupModal %}
{% set tIndex = templateT('index') %}
{% set tsIndex = scriptT('index') %}
{% set sShared = scriptT('shared') %}

<main class="game analysis">

	{# ── Left side bar ─────────────────────────────────────────────────── #}
	<aside class="sidebar scrollbar-thin">

		{# Board-view navigation + view toggles. Managed by guiboardcontrols.ts #}
		<div class="board-controls unselectable">
			<div class="ctrl-row">
				{# View toggles #}
				<div class="ctrl-group">
					{# Perspective - desktop-only #}
					<button class="btn-bare icon-btn tooltip-d desktop-only" id="btn-perspective" data-tooltip="Toggle perspective view">
						<svg><use href="#svg-perspective"/></svg>
					</button>
					{# Arrow-indicators mode - cycles defense → all → all+hippogonals → off #}
					<button class="btn-bare icon-btn tooltip-d" id="btn-arrows" data-tooltip="Arrow indicators: Defense">
						<svg>
							<use href="#svg-arrows-off" class="hidden"/>
							<use href="#svg-arrows-defense"/>
							<use href="#svg-arrows-all" class="hidden"/>
							<use href="#svg-arrows-hippogonals" class="hidden"/>
						</svg>
					</button>
				</div>
				{# Annotation tools - mobile only #}
				<div class="ctrl-group mobile-only">
					<button class="btn-bare icon-btn tooltip-d" id="btn-annotations" data-tooltip="Draw annotations">
						<svg><use href="#svg-pencil"/></svg>
					</button>
					{# Erase / Collapse-rays share one slot (mutually exclusive) #}
					<button class="btn-bare icon-btn tooltip-d" id="btn-erase" data-tooltip="Erase annotations">
						<svg><use href="#svg-erase"/></svg>
					</button>
					<button class="btn-bare icon-btn tooltip-d hidden" id="btn-collapse" data-tooltip="Collapse rays">
						<svg><use href="#svg-collapse"/></svg>
					</button>
				</div>
				{# Board-view navigation #}
				<div class="ctrl-group">
					<button class="btn-bare icon-btn tooltip-d" id="btn-board-back" data-tooltip="Undo transition">
						<svg><use href="#svg-board-back"/></svg>
					</button>
					<button class="btn-bare icon-btn tooltip-d" id="btn-board-expand" data-tooltip="Fit entire game">
						<svg><use href="#svg-board-expand"/></svg>
					</button>
					<button class="btn-bare icon-btn tooltip-d" id="btn-board-recenter" data-tooltip="Recenter">
						<svg><use href="#svg-board-recenter"/></svg>
					</button>
				</div>
			</div>

			{# Coordinate fields - the board coordinates currently being hovered over #}
			<div class="coords">
				<span class="coord">
					<span class="coord-label">X</span>
					<input class="coord-value" id="coord-x" type="text" value="0"/>
				</span>
				<span class="coord">
					<span class="coord-label">Y</span>
					<input class="coord-value" id="coord-y" type="text" value="0"/>
				</span>
			</div>
		</div>

		{# ── Analysis setup: variant picker + flip board ─────────────────── #}
		{% if meta %}
		<div class="game-meta panel analysis-game-meta">
			<div class="meta-info">
				<span class="meta-item">
					<svg class="meta-icon {{ meta.variant.iconId }}"><use href="#{{ meta.variant.iconId }}"/></svg>
					<span class="meta-variant">{{ meta.variant.name }}</span>
				</span>
				&bull;
				<span class="meta-item" title="{{ meta.speed.category | capitalize }}">
					<svg class="meta-icon {{ meta.speed.iconId }}"><use href="#{{ meta.speed.iconId }}"/></svg>
					<span>{{ meta.timeControl }}</span>
				</span>
				&bull;
				<span>{{ "Rated" if meta.rated else "Casual" }}</span>
			</div>

			<div class="meta-foot">
				<time id="meta-started" data-created="{{ meta.timeCreated }}">{{ meta.startedAgo }}</time>
			</div>

			<div class="meta-players">
				{% for color in [p.WHITE, p.BLACK] %}
				{% set player = meta.players[color] %}
				<div class="meta-player">
					<span class="side-dot{{ ' black' if color == p.BLACK }}" title="{{ 'White' if color == p.WHITE else 'Black' }}"></span>
					{{ usernameEmbed(player.name, player.elo, player.eloDiff) }}
				</div>
				{% endfor %}
			</div>

			<div class="result-banner{{ '' if meta.result else ' hidden' }}">
				<span class="result-score">{{ meta.result.score if meta.result }}</span>
				<span class="result-text">{{ meta.result.text if meta.result }}</span>
			</div>
		</div>
		{% else %}
		<div class="analysis-setup panel unselectable">
			<svg class="meta-icon svg-pawn"><use href="#svg-pawn"/></svg>
			<select id="variant-select" class="variant-select" title="Variant">
				{# Placeholder shown when a custom/unrecognized position is imported #}
				<option value="" hidden>Custom position</option>
				{% for g in variantGroups %}
				<optgroup label="{{ g.name }}">
					{% for v in g.variants %}
					<option value="{{ v.code }}">{{ v.name }}</option>
					{% endfor %}
				</optgroup>
				{% endfor %}
			</select>
		</div>
		{% endif %}

		{# ── Engine panel — local evaluation ─────────────────────────────── #}
		{# ── Match panel — moves list (player bars exist for guiclock.ts but stay hidden) ── #}
		<div class="play-group">
			<div class="match-panel panel">
				<div class="player-bar{{ ' hidden' if not meta }}" id="player-bar-top">
					{% if meta %}
					{{ usernameEmbed(meta.players[meta.bars.top].name, meta.players[meta.bars.top].elo) }}
					{% endif %}
					<span class="clock{{ '' if meta and meta.timed else ' hidden' }}"></span>
				</div>

				{# Moves list. Managed by guimoveslist.ts #}
				<div class="moves unselectable">
					<div class="analysis-ceval-panel">
						<div class="engine-progress" id="engine-progress">
							<div class="engine-progress-fill" id="engine-progress-fill"></div>
						</div>
						<div class="engine-header">
							<label class="engine-switch tooltip-d" data-tooltip="Toggle local evaluation (l)">
								<input type="checkbox" id="engine-toggle"/>
								<span class="engine-slider"></span>
							</label>
							<span class="engine-eval" id="engine-eval">-</span>
							<div class="engine-title">
								<span class="engine-name">HydroChess</span>
								<span class="engine-stats" id="engine-stats">Local evaluation off</span>
							</div>
							<button class="btn-bare icon-btn tooltip-d hidden" id="btn-go-deeper" data-tooltip="Search to depth 64">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
							</button>
							<button class="btn-bare icon-btn tooltip-d analysis-engine-btn" id="btn-engine-settings" data-tooltip="Engine settings">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82v.09a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
							</button>
						</div>
						<div class="engine-settings moves-engine-settings hidden" id="engine-settings">
							<div class="setting-row">
								<label for="setting-multipv">Multiple lines</label>
								<input type="range" id="setting-multipv" min="1" max="5" step="1"/>
								<span class="setting-value" id="setting-multipv-value">1</span>
							</div>
							<div class="setting-row">
								<label for="setting-hash">Memory</label>
								<select id="setting-hash">
									<option value="16">16 MB</option>
									<option value="32">32 MB</option>
									<option value="64">64 MB</option>
								</select>
							</div>
							<div class="setting-row">
								<label for="setting-depth">Depth</label>
								<select id="setting-depth">
									<option value="8">8</option>
									<option value="10">10</option>
									<option value="12">12</option>
									<option value="13">13</option>
									<option value="14">14</option>
									<option value="16">16</option>
									<option value="18">18</option>
									<option value="20">20</option>
									<option value="25">25</option>
									<option value="30">30</option>
								</select>
							</div>
						</div>
						<div class="engine-lines" id="engine-lines"></div>
					</div>
					<div class="moves-nav">
						<button class="btn-bare move-btn" id="btn-move-first" title="Rewind to start" disabled><svg class="move-icon"><use href="#svg-move-first"/></svg></button>
						<button class="btn-bare move-btn" id="btn-move-prev" title="Previous move" disabled><svg class="move-icon"><use href="#svg-move-prev"/></svg></button>
						<button class="btn-bare move-btn" id="btn-move-next" title="Next move" disabled><svg class="move-icon"><use href="#svg-move-next"/></svg></button>
						<button class="btn-bare move-btn" id="btn-move-last" title="Skip to latest" disabled><svg class="move-icon"><use href="#svg-move-last"/></svg></button>
						<div class="analysis-actions">
							<button class="btn-bare move-btn analysis-actions-toggle" id="btn-analysis-actions" title="Analysis actions" aria-haspopup="menu" aria-expanded="false">
								<svg class="move-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><line x1="5" y1="7" x2="19" y2="7"/><line x1="5" y1="12" x2="19" y2="12"/><line x1="5" y1="17" x2="19" y2="17"/></svg>
							</button>
							<div class="analysis-actions-menu hidden" id="analysis-actions-menu" role="menu">
								<button type="button" id="btn-flip" role="menuitem">
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="7 8 7 3 3 7"/><line x1="7" y1="3" x2="7" y2="15"/><polyline points="17 16 17 21 21 17"/><line x1="17" y1="21" x2="17" y2="9"/></svg>
									<span>Flip board</span>
								</button>
								<button type="button" id="btn-edit-current" role="menuitem">
									<svg><use href="#svg-pencil"/></svg>
									<span>Board editor</span>
								</button>
								<button type="button" id="btn-continue-from-here" role="menuitem">
									<svg><use href="#svg-swords"/></svg>
									<span>Continue from here</span>
								</button>
							</div>
						</div>
					</div>
					<div class="moves-table scrollbar-thin">
						{# Game result — shown after last move #}
						<div class="game-result hidden">
							<span class="result-score"></span>
							<span class="result-text"></span>
						</div>
					</div>
				</div>

				<div class="player-bar{{ ' hidden' if not meta }}" id="player-bar-bottom">
					{% if meta %}
					{{ usernameEmbed(meta.players[meta.bars.bottom].name, meta.players[meta.bars.bottom].elo) }}
					{% endif %}
					<span class="clock{{ '' if meta and meta.timed else ' hidden' }}"></span>
				</div>
			</div>
		</div>

		{# ── ICN panel — import/export (the analysis page's replacement for chat) ── #}
		<div class="icn-panel panel">
			<div class="icn-bar">
				<span class="icn-title">ICN</span>
				<button class="btn-bare icon-btn tooltip-d" id="btn-icn-copy" data-tooltip="Copy to clipboard">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
				</button>
			</div>
			<textarea class="icn-textarea scrollbar-thin" id="icn-textarea" spellcheck="false" placeholder="Paste an ICN here (with or without moves) and press Import…"></textarea>
			<div class="icn-actions">
				<span class="icn-error" id="icn-error"></span>
				<button class="action-btn" id="btn-icn-import">Import</button>
			</div>
		</div>

	</aside>

	{# ── Eval gauge — vertical win-probability bar beside the board ─────── #}
	<div class="eval-gauge hidden" id="eval-gauge">
		<div class="gauge-black" id="gauge-black"></div>
		<div class="gauge-tick" style="top: 12.5%"></div>
		<div class="gauge-tick" style="top: 25%"></div>
		<div class="gauge-tick" style="top: 37.5%"></div>
		<div class="gauge-tick gauge-zero" style="top: 50%"></div>
		<div class="gauge-tick" style="top: 62.5%"></div>
		<div class="gauge-tick" style="top: 75%"></div>
		<div class="gauge-tick" style="top: 87.5%"></div>
	</div>

	{# Board canvas #}
	<div class="canvas-container bg-checkerboard-dimmed">
		{# The background is visible until the client reveals the canvas when the game is fully loaded #}
		<canvas class="board-canvas visibility-hidden" id="board-canvas"></canvas>
		{# Promotion UI #}
		<div id="promote" class="hidden">
			<div id="promote-white" class="promotecolor hidden"></div>
			<div id="promote-black" class="promotecolor hidden"></div>
		</div>
	</div>
</main>

{{ gameSetupModal(tIndex, sShared, modalVariantGroups, "analysis-setup-modal") }}
<div id="continue-choice-overlay" class="continue-choice-overlay hidden">
	<div class="continue-choice-dialog" role="dialog" aria-label="Continue from here">
		<button class="continue-choice-close" id="continue-choice-close" aria-label="Close">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round">
				<line x1="18" y1="6" x2="6" y2="18"/>
				<line x1="6" y1="6" x2="18" y2="18"/>
			</svg>
		</button>
		<button class="continue-choice-btn" id="continue-play-computer">{{ tsIndex.lobby_buttons.play_computer }}</button>
		<button class="continue-choice-btn" id="continue-challenge-friend">{{ tsIndex.lobby_buttons.challenge_friend }}</button>
	</div>
</div>
{% endblock %}

{% block script %}
<script type="module" src="{{ manifest['scripts/esm/views/analysis/analysis.ts'] }}"></script>
{% endblock %}
