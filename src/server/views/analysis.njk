{% extends "layout.njk" %}

{% set pageName = "Analysis Board" %}

{% block style %}
<link rel="stylesheet" href="{{ manifest['css/game.css'] }}" />
<link rel="stylesheet" href="{{ manifest['css/variantselector.css'] }}" />
<link rel="stylesheet" href="{{ manifest['css/analysis.css'] }}" />
{% endblock %}

{% block head %}
{# SSR→client channel: optional game id to auto-load and the side to view it from, plus
   the hashed engine-worker asset URL (workers can't resolve the manifest themselves)
   and the runtime-copied multithreaded engine package location. #}
<script>window.analysisPageData = {
	gameId: {{ gameId | json | safe }},
	viewColor: {{ viewColor | json | safe }},
	engineAssets: {
		engineUrl: "{{ manifest['engine'] }}",
		workerUrl: "{{ manifest['scripts/esm/views/analysis/apeironanalysis.worker.ts'] }}"
	}
};</script>
{% endblock %}

{% block body %}
{% include "components/header/header.njk" %}
{% from "components/user.njk" import usernameEmbed %}
{% from "components/variantselector.njk" import variantSelector %}
{% set tsIndex = scriptT('index') %}

{# Shared codes-and-labels translations (variants, groups, modifiers, selector labels) #}
{% set s = scriptT('shared') %}

{# Per-player review stats. Hidden until a Game Review is opened, when guigamereview.ts
   reveals it. On /analysis/:id it lives inside the meta panel, which donates its
   .meta-player rows as the column headers; the bare /analysis page has no meta panel, so
   it stands alone and SSRs its own headers instead (`standalone`). #}
{% macro reviewStats(standalone) %}
{% set reviewStatRows = [
	{ key: 'inaccuracy', label: 'Inaccuracies', lapse: true },
	{ key: 'mistake', label: 'Mistakes', lapse: true },
	{ key: 'blunder', label: 'Blunders', lapse: true },
	{ key: 'acpl', label: 'Avg. cp loss', lapse: false }
] %}
<div class="review-stats hidden{{ ' panel' if standalone }}" id="review-stats">
	{% for color in [p.WHITE, p.BLACK] %}
	<div class="review-stats-col" data-player="{{ color }}">
		{% if standalone %}
		<div class="meta-player">
			<span class="side-dot{{ ' black' if color == p.BLACK }}" title="{{ 'White' if color == p.WHITE else 'Black' }}"></span>
			{# Named by guigamereview.ts at review time, off the pasted ICN's metadata. #}
			<span class="review-player-name"></span>
		</div>
		{% endif %}
		<div class="review-accuracy">
			<span class="review-accuracy-value">&mdash;</span>
			<span class="review-stat-label">Accuracy</span>
		</div>
		{% for row in reviewStatRows %}
		<div class="review-stat-row{{ ' review-stat-action unselectable' if row.lapse }}"{% if row.lapse %} tabindex="0" role="button" title="Go to next {{ row.label | lower }}" data-classification="{{ row.key }}"{% endif %}>
			<span class="review-stat-value {{ row.key }}">0</span>
			<span class="review-stat-label">{{ row.label }}</span>
		</div>
		{% endfor %}
	</div>
	{% endfor %}
</div>
{% endmacro %}

<main class="game analysis">

	{# ── Left side bar ─────────────────────────────────────────────────── #}
	<aside class="sidebar scrollbar-thin">

		{# Board-view navigation + view toggles. Managed by guiboardcontrols.ts #}
		<div class="board-controls unselectable">
			<div class="ctrl-row">
				{# Board-view navigation #}
				<div class="ctrl-group">
					<button class="btn-bare icon-btn tooltip-d" id="btn-board-back" data-tooltip="Undo transition">
						<svg><use href="#svg-board-back"/></svg>
					</button>
					<button class="btn-bare icon-btn tooltip-d" id="btn-board-expand" data-tooltip="Fit entire game">
						<svg><use href="#svg-board-expand"/></svg>
					</button>
					<button class="btn-bare icon-btn tooltip-d" id="btn-board-recenter" data-tooltip="Recenter">
						<svg><use href="#svg-board-recenter"/></svg>
					</button>
				</div>
				{# Annotation tools - mobile only #}
				<div class="ctrl-group mobile-only">
					<button class="btn-bare icon-btn tooltip-d" id="btn-annotations" data-tooltip="Draw annotations">
						<svg><use href="#svg-pencil"/></svg>
					</button>
					{# Erase / Collapse-rays share one slot (mutually exclusive) #}
					<button class="btn-bare icon-btn tooltip-d" id="btn-erase" data-tooltip="Erase annotations">
						<svg><use href="#svg-erase"/></svg>
					</button>
					<button class="btn-bare icon-btn tooltip-d hidden" id="btn-collapse" data-tooltip="Collapse rays">
						<svg><use href="#svg-collapse"/></svg>
					</button>
				</div>
				{# View toggles #}
				<div class="ctrl-group">
					{# Arrow-indicators mode - cycles defense → all → all+hippogonals → off #}
					<button class="btn-bare icon-btn tooltip-d" id="btn-arrows" data-tooltip="Arrow indicators: Defense">
						<svg>
							<use href="#svg-arrows-off" class="hidden"/>
							<use href="#svg-arrows-defense"/>
							<use href="#svg-arrows-all" class="hidden"/>
							<use href="#svg-arrows-hippogonals" class="hidden"/>
						</svg>
					</button>
					{# Perspective - desktop-only #}
					<button class="btn-bare icon-btn tooltip-d desktop-only" id="btn-perspective" data-tooltip="Toggle perspective view">
						<svg><use href="#svg-perspective"/></svg>
					</button>
				</div>
			</div>

			{# Coordinate fields - the board coordinates currently being hovered over #}
			<div class="coords">
				<span class="coord">
					<span class="coord-label">X</span>
					<input class="coord-value" id="coord-x" type="text" value="0"/>
				</span>
				<span class="coord">
					<span class="coord-label">Y</span>
					<input class="coord-value" id="coord-y" type="text" value="0"/>
				</span>
			</div>
		</div>

		{% if meta %}
		<div class="game-meta panel">
			<div class="meta-info">
				<span class="meta-item">
					<svg class="meta-icon {{ meta.variant.iconId }}"><use href="#{{ meta.variant.iconId }}"/></svg>
					<span class="meta-variant">{{ meta.variant.name }}</span>
				</span>
				&bull;
				<span class="meta-item" title="{{ meta.speed.category | capitalize }}">
					<svg class="meta-icon {{ meta.speed.iconId }}"><use href="#{{ meta.speed.iconId }}"/></svg>
					<span>{{ meta.timeControl }}</span>
				</span>
				&bull;
				<span>{{ "Rated" if meta.rated else "Casual" }}</span>
			</div>

			{# Gamerule modifications. Omitted entirely when the game plays by the standard rules. #}
			{% if meta.rules.length %}
			<p class="meta-rules">
				{%- for line in meta.rules %}{{ " " if not loop.first }}
				{%- if line.kind == "text" %}{{ line.text }}
				{%- else %}<span class="promotion-icons piece-silhouette">{{ line.prefix }}
					{# Only the piece icons are `| safe`: this markup is our own svg asset files, never input. #}
					{%- for svg in line.svgs %}{{ svg | safe }}{% endfor %}{{ line.suffix }}</span>
				{%- endif %}
				{%- endfor -%}
			</p>
			{% endif %}

			<div class="meta-foot">
				<time id="meta-started" data-created="{{ meta.timeCreated }}">{{ meta.startedAgo }}</time>
			</div>

			<div class="meta-players">
				{% for color in [p.WHITE, p.BLACK] %}
				{% set player = meta.players[color] %}
				<div class="meta-player">
					<span class="side-dot{{ ' black' if color == p.BLACK }}" title="{{ 'White' if color == p.WHITE else 'Black' }}"></span>
					{{ usernameEmbed(player.name, player.elo, player.eloDiff) }}
				</div>
				{% endfor %}
			</div>

			<div class="result-banner{{ '' if meta.result else ' hidden' }}">
				<span class="result-score">{{ meta.result.score if meta.result }}</span>
				<span class="result-text">{{ meta.result.text if meta.result }}</span>
			</div>

			{{ reviewStats(false) }}
		</div>
		{% else %}
		{# Variant + modifiers picker #}
		<div class="variant-setup panel">
			{{ variantSelector(variantGroups, s) }}
		</div>
		{{ reviewStats(true) }}
		{% endif %}

		{# Material bars + match panel #}
		<div class="play-group">

			{# Top side's captured surplus material. Managed by guimaterial.ts #}
			<div class="material" id="material-top"></div>

			<div class="match-panel panel">
				<div class="player-bar{{ ' hidden' if not meta }}" id="player-bar-top">
					{% if meta %}
					{{ usernameEmbed(meta.players[meta.bars.top].name, meta.players[meta.bars.top].elo) }}
					{% endif %}
					<span class="clock{{ ' hidden' if not (meta and meta.timed) }}"></span>
				</div>

				{# Moves list. Managed by guimoveslist.ts #}
				<div class="moves unselectable">
					{# Managed by guienginepanel.ts #}
					<div class="engine-panel">
						<div class="engine-progress" id="engine-progress">
							<div class="engine-progress-fill" id="engine-progress-fill"></div>
						</div>
						<div class="engine-header">
							<div class="engine-header-main">
								<label class="switch engine-switch tooltip-d" data-tooltip="Toggle local evaluation (l)">
									<input type="checkbox" id="engine-toggle"/>
									<span></span>
								</label>
								<span class="engine-eval" id="engine-eval">-</span>
								<div class="engine-title">
									<span class="engine-name" id="engine-name">{{ engineNameVersioned }}</span>
									<span class="engine-stats" id="engine-stats">Local evaluation off</span>
								</div>
								<button class="btn-bare icon-btn tooltip-d hidden" id="btn-go-deeper" data-tooltip="Search to depth 64">
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
								</button>
							</div>
							<button class="btn-bare icon-btn tooltip-dl" id="btn-engine-settings" data-tooltip="Engine settings">
								<svg class="gear"><use href="#svg-gear"/></svg>
							</button>
						</div>
						<div class="engine-settings hidden" id="engine-settings">
							{# All sliders. multipv/threads/depth are direct-value; hash is an index
							   slider (JS maps the index to the real MB value). #}
							<div class="setting-row">
								<label for="setting-multipv">Multiple lines</label>
								<input type="range" class="slider" id="setting-multipv" min="1" max="5" step="1"/>
								<span class="setting-value" id="setting-multipv-value">1</span>
							</div>
							<div class="setting-row">
								<label for="setting-threads">Threads</label>
								<input type="range" class="slider" id="setting-threads" min="1" step="1"/>
								<span class="setting-value" id="setting-threads-value">1</span>
							</div>
							<div class="setting-row">
								<label for="setting-hash">Memory</label>
								<input type="range" class="slider" id="setting-hash" min="0" step="1"/>
								<span class="setting-value" id="setting-hash-value">16 MB</span>
							</div>
							<div class="setting-row">
								<label for="setting-depth">Depth</label>
								<input type="range" class="slider" id="setting-depth" min="1" max="64" step="1"/>
								<span class="setting-value" id="setting-depth-value">13</span>
							</div>
						</div>
						<div class="engine-lines" id="engine-lines"></div>
					</div>
					<div class="moves-table scrollbar-thin">
						{# Game result — shown after last move #}
						<div class="game-result hidden">
							<span class="result-score"></span>
							<span class="result-text"></span>
						</div>
					</div>
					<div class="moves-nav">
						<button class="btn-bare move-btn" id="btn-move-first" title="Rewind to start" disabled><svg class="move-icon"><use href="#svg-move-first"/></svg></button>
						<button class="btn-bare move-btn" id="btn-move-prev" title="Previous move" disabled><svg class="move-icon"><use href="#svg-move-prev"/></svg></button>
						<button class="btn-bare move-btn" id="btn-move-next" title="Next move" disabled><svg class="move-icon"><use href="#svg-move-next"/></svg></button>
						<button class="btn-bare move-btn" id="btn-move-last" title="Skip to latest" disabled><svg class="move-icon"><use href="#svg-move-last"/></svg></button>
						<button class="btn-bare move-btn analysis-actions-toggle" id="btn-analysis-actions" title="More actions" aria-haspopup="menu" aria-expanded="false">
							<svg class="move-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><line x1="5" y1="7" x2="19" y2="7"/><line x1="5" y1="12" x2="19" y2="12"/><line x1="5" y1="17" x2="19" y2="17"/></svg>
						</button>
						{# More actions menu #}
						<div class="analysis-menu hidden" id="analysis-actions-menu">
							<button type="button" id="btn-flip">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="7 8 7 3 3 7"/><line x1="7" y1="3" x2="7" y2="15"/><polyline points="17 16 17 21 21 17"/><line x1="17" y1="21" x2="17" y2="9"/></svg>
								<span>Flip board</span>
							</button>
							<button type="button" id="btn-edit-current">
								<svg><use href="#svg-pencil"/></svg>
								<span>Board editor</span>
							</button>
							<button type="button" id="btn-export-icn">
								<svg><use href="#svg-clipboard"/></svg>
								<span>Export ICN</span>
							</button>
							<button type="button" id="btn-continue-from-here">
								<svg><use href="#svg-pawn"/></svg>
								<span>Continue from here</span>
							</button>
						</div>
						{# Continue-from-here choice menu #}
						<div class="analysis-menu hidden" id="continue-choice-menu">
							<button type="button" id="continue-public-seek">
								<svg><use href="#svg-globe"/></svg>
								<span>{{ tsIndex.lobby_buttons.create_online }}</span>
							</button>
							<button type="button" id="continue-play-computer">
								<svg><use href="#svg-engine"/></svg>
								<span>{{ tsIndex.lobby_buttons.play_computer }}</span>
							</button>
							<button type="button" id="continue-challenge-friend">
								<svg><use href="#svg-profile"/></svg>
								<span>{{ tsIndex.lobby_buttons.challenge_friend }}</span>
							</button>
						</div>
					</div>

					{# Game review progress #}
					<div class="review-progress selectable hidden" id="review-progress">
						<div class="review-progress-bar">
							<div class="review-progress-fill" id="review-progress-fill"></div>
						</div>
						<span class="review-progress-text" id="review-progress-text"></span>
					</div>
				</div>

				<div class="player-bar{{ ' hidden' if not meta }}" id="player-bar-bottom">
					{% if meta %}
					{{ usernameEmbed(meta.players[meta.bars.bottom].name, meta.players[meta.bars.bottom].elo) }}
					{% endif %}
					<span class="clock{{ ' hidden' if not (meta and meta.timed) }}"></span>
				</div>
			</div>

			{# Bottom side's captured surplus material #}
			<div class="material" id="material-bottom"></div>

			{# Game Review start button. Hidden on first paint — only the client can tell whether
			a game is reviewable, and revealing it up front would flicker it away again on the
			ones that aren't. guigamereview.ts decides on every load. #}
			<button class="btn-primary hidden" id="btn-game-review">Game Review</button>

			{# Game Review graph #}
			<div class="review-graph panel hidden" id="review-graph">
				<canvas id="review-graph-canvas"></canvas>
				<div class="review-phase-markers" id="review-phase-markers"></div>
				<div class="review-graph-tooltip hidden" id="review-graph-tooltip">
					<strong class="move" id="review-graph-tooltip-move"></strong>
					<span class="eval" id="review-graph-tooltip-eval"></span>
				</div>
			</div>
		</div>

	</aside>

	{# Eval gauge #}
	<div class="eval-gauge hidden" id="eval-gauge">
		<div class="gauge-black" id="gauge-black"></div>
		{# Ticks every 12.5%; the 50% one is the emphasized zero line. #}
		{% for pct in [12.5, 25, 37.5, 50, 62.5, 75, 87.5] %}
		<div class="gauge-tick{{ ' gauge-zero' if pct == 50 }}" style="top: {{ pct }}%"></div>
		{% endfor %}
	</div>

	{# Board canvas #}
	<div class="canvas-container bg-checkerboard-dimmed">
		{# The background is visible until the client reveals the canvas when the game is fully loaded #}
		<canvas class="board-canvas visibility-hidden" id="board-canvas"></canvas>
		{# Promotion UI #}
		<div id="promote" class="hidden">
			<div id="promote-white" class="promotecolor hidden"></div>
			<div id="promote-black" class="promotecolor hidden"></div>
		</div>
	</div>
</main>
{% endblock %}

{% block script %}
<script type="module" src="{{ manifest['scripts/esm/views/analysis/analysis.ts'] }}"></script>
{% endblock %}
