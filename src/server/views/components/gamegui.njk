{# An interactive board page's sidebar and canvas regions, one macro each, mirroring the client
   modules in src/client/scripts/esm/game/gui/ that drive them. Regions tagged "SSR-OWNED" are
   rendered from `meta` and must never be re-rendered by the client — it only writes live deltas
   into them (clocks, `tempo`, `eloChange`). #}

{% from "components/user.njk" import usernameEmbed %}
{% from "components/seekproperties.njk" import seekProperties, seekRules %}

{# Board-view navigation + view toggles. Managed by guiboardcontrols.ts #}
{% macro boardControls() %}
<div class="board-controls unselectable">
	<div class="ctrl-row">
		{# Board-view navigation #}
		<div class="ctrl-group">
			<button class="btn-bare icon-btn tooltip-d" id="btn-board-back" data-tooltip="Undo transition">
				<svg><use href="#svg-board-back"/></svg>
			</button>
			<button class="btn-bare icon-btn tooltip-d" id="btn-board-expand" data-tooltip="Fit entire game">
				<svg><use href="#svg-board-expand"/></svg>
			</button>
			<button class="btn-bare icon-btn tooltip-d" id="btn-board-recenter" data-tooltip="Recenter">
				<svg><use href="#svg-board-recenter"/></svg>
			</button>
		</div>
		{# Annotation tools - mobile only #}
		<div class="ctrl-group mobile-only">
			<button class="btn-bare icon-btn tooltip-d" id="btn-annotations" data-tooltip="Draw annotations">
				<svg><use href="#svg-pencil"/></svg>
			</button>
			{# Erase / Collapse-rays share one slot (mutually exclusive) #}
			<button class="btn-bare icon-btn tooltip-d" id="btn-erase" data-tooltip="Erase annotations">
				<svg><use href="#svg-erase"/></svg>
			</button>
			<button class="btn-bare icon-btn tooltip-d hidden" id="btn-collapse" data-tooltip="Collapse rays">
				<svg><use href="#svg-collapse"/></svg>
			</button>
		</div>
		{# View toggles #}
		<div class="ctrl-group">
			{# Arrow-indicators mode - cycles defense → all → all+hippogonals → off #}
			<button class="btn-bare icon-btn tooltip-d" id="btn-arrows" data-tooltip="Arrow indicators: Defense (tab)">
				<svg>
					<use href="#svg-arrows-off" class="hidden"/>
					<use href="#svg-arrows-defense"/>
					<use href="#svg-arrows-all" class="hidden"/>
					<use href="#svg-arrows-hippogonals" class="hidden"/>
				</svg>
			</button>
			{# Perspective - desktop-only #}
			<button class="btn-bare icon-btn tooltip-d desktop-only" id="btn-perspective" data-tooltip="Toggle perspective view">
				<svg><use href="#svg-perspective"/></svg>
			</button>
		</div>
	</div>

	{# Coordinate fields - the board coordinates currently being hovered over #}
	<div class="coords">
		<span class="coord">
			<span class="coord-label">X</span>
			<input class="coord-value" id="coord-x" type="text" value="0"/>
		</span>
		<span class="coord">
			<span class="coord-label">Y</span>
			<input class="coord-value" id="coord-y" type="text" value="0"/>
		</span>
	</div>
</div>
{% endmacro %}

{# Game metadata — all static information about a game. `spectators` renders the live
   spectator count. Called with `{% call %}`, the block's content closes the panel. #}
{% macro gameMeta(meta, spectators=false) %}
<div class="game-meta panel">

	{# Original seek's properties — SSR-OWNED. #}
	{{ seekProperties(meta.seekProperties) }}
	{{ seekRules(meta.seekProperties.rules) }}

	{# Started X ago. `#meta-started` carries the creation epoch so the client can re-derive
	   the ticking string. The client sets the spectator count, hiding it if none. #}
	<div class="meta-foot">
		<time id="meta-started" data-created="{{ meta.timeCreated }}">{{ meta.startedAgo }}</time>
		{% if spectators %}
		<span class="meta-spectators hidden" title="Spectators">
			<svg class="meta-eye"><use href="#svg-eye"/></svg>
			<span class="spectator-count unselectable"></span>
		</span>
		{% endif %}
	</div>

	{# Participants — SSR-OWNED (white row, then black row). #}
	<div class="meta-players">
		{% for color in [p.WHITE, p.BLACK] %}
		{% set player = meta.players[color] %}
		<div class="meta-player">
			<span class="side-dot{{ ' black' if color == p.BLACK }}" title="{{ 'White' if color == p.WHITE else 'Black' }}"></span>
			{{ usernameEmbed(player.name, player.elo, player.eloDiff) }}
		</div>
		{% endfor %}
	</div>

	{# Result banner — filled when the game is already concluded at load, otherwise empty and
	   `.hidden` until the client reveals it and writes the score/text on game end. #}
	<div class="result-banner{{ '' if meta.result else ' hidden' }}">
		<span class="result-score">{{ meta.result.score if meta.result }}</span>
		<span class="result-text">{{ meta.result.text if meta.result }}</span>
	</div>

	{% if caller %}{{ caller() }}{% endif %}
</div>
{% endmacro %}

{# A side's username container — SSR-OWNED. `side` is 'top' (the opponent, or black for
   spectators) or 'bottom' (you, or white). Without `meta` it renders hidden and nameless. #}
{% macro playerBar(meta, side) %}
<div class="player-bar{{ ' hidden' if not meta }}" id="player-bar-{{ side }}">
	{% if meta %}
	{{ usernameEmbed(meta.players[meta.bars[side]].name, meta.players[meta.bars[side]].elo) }}
	{% endif %}
	{# Clock — hidden for untimed games. guiclock.ts writes the ticking value. #}
	<span class="clock{{ '' if meta and meta.timed else ' hidden' }}"></span>
</div>
{% endmacro %}

{# A side's captured surplus material. guimaterial.ts injects one silhouette per surplus piece. #}
{% macro material(side) %}
<div class="material" id="material-{{ side }}"></div>
{% endmacro %}

{# Move-navigation buttons. Managed by guimoveslist.ts. Called with `{% call %}`, the block's
   content follows the buttons. #}
{% macro movesNav() %}
<div class="moves-nav">
	<button class="btn-bare move-btn" id="btn-move-first" title="Rewind to start" disabled><svg class="move-icon"><use href="#svg-move-first"/></svg></button>
	<button class="btn-bare move-btn" id="btn-move-prev" title="Previous move" disabled><svg class="move-icon"><use href="#svg-move-prev"/></svg></button>
	<button class="btn-bare move-btn" id="btn-move-next" title="Next move" disabled><svg class="move-icon"><use href="#svg-move-next"/></svg></button>
	<button class="btn-bare move-btn" id="btn-move-last" title="Skip to latest" disabled><svg class="move-icon"><use href="#svg-move-last"/></svg></button>
	{% if caller %}{{ caller() }}{% endif %}
</div>
{% endmacro %}

{# The moves list. Managed by guimoveslist.ts #}
{% macro movesTable() %}
<div class="moves-table scrollbar-thin">
	{# Game result — shown after last move #}
	<div class="game-result hidden">
		<span class="result-score"></span>
		<span class="result-text"></span>
	</div>
</div>
{% endmacro %}

{# Board canvas #}
{% macro boardCanvas() %}
<div class="canvas-container bg-checkerboard-dimmed">
	{# The background is visible until the client reveals the canvas when the game is fully loaded #}
	<canvas class="board-canvas visibility-hidden" id="board-canvas"></canvas>
	{# Promotion UI. Managed by guipromotion.ts #}
	<div id="promote" class="hidden">
		<div id="promote-white" class="promotecolor hidden"></div>
		<div id="promote-black" class="promotecolor hidden"></div>
	</div>
</div>
{% endmacro %}
