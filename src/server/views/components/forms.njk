{# Password input with a show/hide eye toggle, shared by the login, register, and reset-password
   pages. The toggle's behavior is wired by util/passwordToggle.ts (which keys off the .password-toggle class). #}
{% macro passwordInput(id, name, autocomplete) %}
<div class="password-wrap">
	{# maxlength 72: the password max length from validatePassword() in validators.ts (bcrypt's 72-byte limit). #}
	<input class="auth-input" type="password" id="{{ id }}" name="{{ name }}" autocomplete="{{ autocomplete }}" maxlength="72" required />
	<button type="button" class="password-toggle">
		<svg class="glyph password-eye" viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
		<svg class="glyph password-eye-off hidden" viewBox="0 0 24 24"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
	</button>
</div>
{% endmacro %}
