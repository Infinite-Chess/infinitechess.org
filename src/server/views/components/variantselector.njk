{#
   The variant + modifiers picker widget, shared by the game-options modal (index.njk)
   and the analysis board setup panel (analysis.njk). All labels come from `s`
   (= scriptT('shared')), so the widget carries no page-specific translations.
   Behaviour lives in src/client/scripts/esm/components/variantselector/, styles in
   src/client/css/variantselector.css.
#}

{% macro eyeIcon() %}<svg class="svg-eye preview"><use href="#svg-eye"></use></svg>{% endmacro %}

{% macro variantGroupItem(group, iconId, name, description, arrow=true, id=none) %}
<button class="variant-group-item"{% if group %} data-group="{{ group }}"{% endif %}{% if id %} id="{{ id }}"{% endif %}>
	<svg class="group-icon {{ iconId }}"><use href="#{{ iconId }}"/></svg>
	<span class="group-name">{{ name }}</span>
	<span class="group-desc">{{ description }}</span>
	{% if arrow %}<svg class="group-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 15 12 9 18"/></svg>{% endif %}
</button>
{% endmacro %}

{% macro variantListBack(iconId, name, description) %}
<button class="variant-list-back">
	<svg class="back-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
	<svg class="group-icon {{ iconId }}"><use href="#{{ iconId }}"/></svg>
	<span class="group-name">{{ name }}</span>
	<span class="group-desc">{{ description }}</span>
</button>
{% endmacro %}

{# The full widget. `variantGroups` is variantregistry.getVariantGroupsWithVariants();
   `s` is scriptT('shared'). #}
{% macro variantSelector(variantGroups, s) %}
<div class="variant-selector-widget">
	<span class="model-label">{{ s.variant_selector.label }}</span>
	{# Variant selector #}
	<div class="variant-selector" id="variant-selector">
		<button class="variant-display" id="variant-display">
			<svg class="variant-group-icon" id="variant-group-icon"><use></use></svg>
			<span id="variant-name" class="variant-name"></span>
			<svg class="modifier-add tooltip-d" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" data-tooltip="{{ s.variant_selector.add_modifier }}"><line x1="12" y1="4" x2="12" y2="20"/><line x1="4" y1="12" x2="20" y2="12"/></svg>
			<svg class="svg-pencil tooltip-d" data-tooltip="{{ s.variant_selector.edit }}"><use href="#svg-pencil"></use></svg>
			{{ eyeIcon() }}
			<svg class="selector-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
		</button>
		<div class="variant-dropdown" id="variant-dropdown">
			{% for g in variantGroups %}
			{{ variantGroupItem(g.group, g.iconId, s.variant_groups[g.group].name, s.variant_groups[g.group].description) }}
			{% endfor %}
		</div>
		{% for g in variantGroups %}
		<div class="variant-dropdown variant-list-panel" data-group="{{ g.group }}">
			{{ variantListBack(g.iconId, s.variant_groups[g.group].name, s.variant_groups[g.group].description) }}
			{% for v in g.variants %}
			<button class="variant-item" data-code="{{ v }}">
				<span class="variant-name">{{ s.variants[v] }}</span>
				{{ eyeIcon() }}
			</button>
			{% endfor %}
		</div>
		{% endfor %}
		<div class="variant-dropdown variant-list-panel" data-group="custom" id="variant-custom-panel">
			{{ variantListBack("svg-wrench", s.variant_groups.custom.name, s.variant_groups.custom.description) }}
			{{ variantGroupItem(none, "svg-pencil",    s.variant_selector.custom_create_name,   s.variant_selector.custom_create_desc,   arrow=false, id="btn-custom-create") }}
			{{ variantGroupItem(none, "svg-clipboard", s.variant_selector.custom_from_icn_name, s.variant_selector.custom_from_icn_desc, arrow=false, id="btn-custom-from-icn") }}
			<div id="variant-custom-content"></div>
		</div>
		<div class="variant-dropdown modifier-dropdown" id="modifier-dropdown">
			<button class="variant-group-item" data-modifier="slide-limit">
				<svg class="group-icon svg-slide-limit"><use href="#svg-slide-limit"></use></svg>
				<span class="group-name">{{ s.modifiers["slide-limit"].name }}</span>
				<span class="group-desc">{{ s.modifiers["slide-limit"].description }}</span>
			</button>
		</div>
	</div>
	{# Custom ICN - revealed when "From ICN" is selected in the Custom group #}
	<div id="variant-custom-section" class="hidden">
		<div class="icn-input-wrap">
			<textarea class="icn-input" id="icn-input" spellcheck="false"
			          placeholder="{{ s.variant_selector.icn_placeholder }}" rows="1"></textarea>
		</div>
	</div>
	<p id="icn-error-text" class="icn-error-text"></p>
	{# Modifiers - revealed when at least one modifier is selected #}
	<div id="modifiers-section" class="hidden">
		<div class="modifiers-row">
			<span class="modifiers-label">{{ s.modifiers_section.label }}</span>
			<div class="modifiers-list" id="modifiers-list"></div>
		</div>
		<div id="slide-limit-section" class="slide-limit-section hidden">
			<span class="slide-limit-name">{{ s.modifiers["slide-limit"].name }}</span>
			<input type="range" class="slider" id="slider-slide-limit" min="0" max="25" step="1">
			<span class="slider-value" id="slide-limit-display"></span>
		</div>
	</div>
</div>
{% endmacro %}
