{# A seek's properties: variant, time control, rated or casual, and its gamerule modifications.
   Renders a `SeekPropertiesViewModel` (src/server/controllers/seekProperties.ts). #}

{% macro seekProperties(props) %}
<div class="meta-info">
	<span class="meta-item">
		<svg class="meta-icon {{ props.variant.iconId }}"><use href="#{{ props.variant.iconId }}"/></svg>
		<span class="meta-variant">{{ props.variant.name }}</span>
	</span>
	•
	<span class="meta-item" title="{{ props.speed.name }}">
		<svg class="meta-icon {{ props.speed.iconId }}"><use href="#{{ props.speed.iconId }}"/></svg>
		<span>{{ props.timeControl }}</span>
	</span>
	•
	<span>{{ props.mode }}</span>
</div>

{# Gamerule modifications. Omitted when it plays by the standard rules.
   Matches the gamerule modifications variant preview tooltips show on the seek. #}
{% if props.rules.length %}
<p class="meta-rules">
	{%- for line in props.rules %}{{ " " if not loop.first }}
	{%- if line.kind == "text" %}{{ line.text }}
	{%- else %}<span class="promotion-icons piece-silhouette">{{ line.prefix }}
		{# Only the piece icons are `| safe`: this markup is our own svg asset files, never input. #}
		{%- for svg in line.svgs %}{{ svg | safe }}{% endfor %}{{ line.suffix }}</span>
	{%- endif %}
	{%- endfor -%}
</p>
{% endif %}
{% endmacro %}
