{% extends "layout.njk" %}

{% set pageName = "Game" %}

{% block style %}
<link rel="stylesheet" href="{{ manifest['css/game.css'] }}" />
{% endblock %}

{% block head %}
{# SSR→client channel: the numeric game id and a best-effort liveness hint (can be innacurate by the time they render). #}
<script>window.gamePageData = {{ gamePageData | json | safe }};</script>
{% endblock %}

{% block body %}
{% include "components/header/header.njk" %}

{# ── Macros ────────────────────────────────────────────#}
{% from "components/user.njk" import usernameEmbed %}

{# ════════════════════════════════════════════════════════════════════════
   NOTE FOR T9 (client wiring): regions tagged "SSR-OWNED" are rendered
   server-side from the `meta` view-model + `gamePageData` (game-meta info,
   participant list, player-bar names/ratings/orientation) and must NOT be
   re-rendered by the client — it only writes live deltas into them (clock
   values, `tempo`, `eloChange`). Blocks tagged "EXAMPLE" are static sample
   structure only; the client REPLACES their contents (and toggles `.hidden`)
   once real game data loads. Static "skeleton" blocks (result-banner,
   draw-offer, disconnect-status) are ALWAYS SSR'd with fixed structure and
   start `.hidden` (unless already true at load); the client only toggles
   `.hidden` + writes their text — it must never rebuild their markup.
   ════════════════════════════════════════════════════════════════════════ #}
<main class="game">

	{# ── Left side bar ─────────────────────────────────────────────────── #}
	<aside class="sidebar scrollbar-thin">

		{# Board-view navigation + view toggles. Managed by guiboardcontrols.ts #}
		<div class="board-controls unselectable">
			<div class="ctrl-row">
				{# Board-view navigation #}
				<div class="ctrl-group">
					<button class="btn-bare icon-btn tooltip-d" id="btn-board-back" data-tooltip="Undo transition">
						<svg><use href="#svg-board-back"/></svg>
					</button>
					<button class="btn-bare icon-btn tooltip-d" id="btn-board-expand" data-tooltip="Fit entire game">
						<svg><use href="#svg-board-expand"/></svg>
					</button>
					<button class="btn-bare icon-btn tooltip-d" id="btn-board-recenter" data-tooltip="Recenter">
						<svg><use href="#svg-board-recenter"/></svg>
					</button>
				</div>
				{# Annotation tools - mobile only #}
				<div class="ctrl-group mobile-only">
					<button class="btn-bare icon-btn tooltip-d" id="btn-annotations" data-tooltip="Draw annotations">
						<svg><use href="#svg-pencil"/></svg>
					</button>
					{# Erase / Collapse-rays share one slot (mutually exclusive) #}
					<button class="btn-bare icon-btn tooltip-d" id="btn-erase" data-tooltip="Erase annotations">
						<svg><use href="#svg-erase"/></svg>
					</button>
					<button class="btn-bare icon-btn tooltip-d hidden" id="btn-collapse" data-tooltip="Collapse rays">
						<svg><use href="#svg-collapse"/></svg>
					</button>
				</div>
				{# View toggles #}
				<div class="ctrl-group">
					{# Arrow-indicators mode - cycles defense → all → all+hippogonals → off #}
					<button class="btn-bare icon-btn tooltip-d" id="btn-arrows" data-tooltip="Arrow indicators: Defense (tab)">
						<svg>
							<use href="#svg-arrows-off" class="hidden"/>
							<use href="#svg-arrows-defense"/>
							<use href="#svg-arrows-all" class="hidden"/>
							<use href="#svg-arrows-hippogonals" class="hidden"/>
						</svg>
					</button>
					{# Perspective - desktop-only #}
					<button class="btn-bare icon-btn tooltip-d desktop-only" id="btn-perspective" data-tooltip="Toggle perspective view">
						<svg><use href="#svg-perspective"/></svg>
					</button>
				</div>
			</div>

			{# Coordinate fields - the board coordinates currently being hovered over #}
			<div class="coords">
				<span class="coord">
					<span class="coord-label">X</span>
					<input class="coord-value" id="coord-x" type="text" value="0"/>
				</span>
				<span class="coord">
					<span class="coord-label">Y</span>
					<input class="coord-value" id="coord-y" type="text" value="0"/>
				</span>
			</div>
		</div>

		{# Game metadata — all static information about a game #}
		<div class="game-meta panel">

			{# Original seek's properties — SSR-OWNED (rendered from `meta`); not re-rendered by the client. #}
			<div class="meta-info">
				<span class="meta-item">
					<svg class="meta-icon svg-pawn"><use href="#svg-pawn"/></svg>
					<span class="meta-variant">Classical</span>
				</span>
				•
				<span class="meta-item" title="{{ meta.speed.category | capitalize }}">
					<svg class="meta-icon {{ meta.speed.iconId }}"><use href="#{{ meta.speed.iconId }}"/></svg>
					<span>{{ meta.timeControl }}</span>
				</span>
				•
				<span>{{ "Rated" if meta.rated else "Casual" }}</span>
			</div>

			{# Gamerule modifications
			   EXAMPLE — the client builds this from the game's gamerules, and omits the row when none.
			   Wording takes inspiration from variant preview tooltips #}
			{# <p class="meta-rules">Black moves first. No promotion. No 50-move rule.</p> #}

			{# Started X ago + live spectator count.
			   `#meta-started` is SSR-OWNED: rendered with the relative string for first paint + the
			   creation epoch, so the client re-derives the ticking string (same shared helper).
			   The spectator count stays dynamic (the client sets + hides if none). #}
			<div class="meta-foot">
				<time id="meta-started" data-created="{{ meta.timeCreated }}">{{ meta.startedAgo }}</time>
				<span class="meta-spectators hidden" title="Spectators">
					<svg class="meta-eye"><use href="#svg-eye"/></svg>
					<span class="spectator-count">0</span>
				</span>
			</div>

			{# Participants — SSR-OWNED (white row then black row, fixed order); not re-rendered by the client. #}
			<div class="meta-players">
				{% for color in [p.WHITE, p.BLACK] %}
				{% set player = meta.players[color] %}
				<div class="meta-player">
					<span class="side-dot{{ ' black' if color == p.BLACK }}" title="{{ 'White' if color == p.WHITE else 'Black' }}"></span>
					{{ usernameEmbed(player.name, player.elo, player.eloDiff) }}
				</div>
				{% endfor %}
			</div>

			{# Result banner — static skeleton, always SSR'd. Visible + filled when the game is
			   already concluded at load; otherwise `.hidden` and empty, and the client reveals it +
			   sets the score/text the moment the game ends live. Structure is fixed, so the
			   client only toggles `.hidden` and writes text — never rebuilds it. #}
			<div class="result-banner{{ '' if meta.result else ' hidden' }}">
				<span class="result-score">{{ meta.result.score if meta.result }}</span>
				<span class="result-text">{{ meta.result.text if meta.result }}</span>
			</div>
		</div>

		{# Material bars + match panel #}
		<div class="play-group">

			{# Top side's captured material
			Top = the opponent (player view) or black (spectator view).
			The client injects one <svg> per surplus piece via svgcache.getSilhouetteSVG(). #}
			<div class="material" id="material-top">
				{# EXAMPLE #}
				{# <svg class="material-piece"><use href="#svg-pawn"/></svg>
				<svg class="material-piece"><use href="#svg-pawn"/></svg>
				<span class="material-lead">+2</span> #}
				{# /EXAMPLE #}
			</div>

			{# Match panel - Clocks, moves list, game actions #}
			<div class="match-panel panel">

				{# Top username container — SSR-OWNED (far side: the opponent, or black for spectators).
				   Username/rating + clock are SSR'd; guiclock.ts writes the live clock value + `tempo`,
				   and appends the `eloChange` delta on game end #}
				<div class="player-bar" id="player-bar-top">
					{{ usernameEmbed(meta.players[meta.bars.top].name, meta.players[meta.bars.top].elo) }}
					{# Clock — SSR'd present (hidden for untimed games); the client only toggles `.hidden`
					   and writes the ticking value. #}
					<span class="clock{{ '' if meta.timed else ' hidden' }}"></span>
				</div>

				{# Moves list + game-over result. Managed by guimoveslist.ts #}
				<div class="moves unselectable">
					<div class="moves-nav">
						<button class="btn-bare move-btn" id="btn-move-first" title="Rewind to start" disabled><svg class="move-icon"><use href="#svg-move-first"/></svg></button>
						<button class="btn-bare move-btn" id="btn-move-prev" title="Previous move" disabled><svg class="move-icon"><use href="#svg-move-prev"/></svg></button>
						<button class="btn-bare move-btn" id="btn-move-next" title="Next move" disabled><svg class="move-icon"><use href="#svg-move-next"/></svg></button>
						<button class="btn-bare move-btn" id="btn-move-last" title="Skip to latest" disabled><svg class="move-icon"><use href="#svg-move-last"/></svg></button>
					</div>
					<div class="moves-table scrollbar-thin">
						{# Game result — shown after last move #}
						<div class="game-result hidden">
							<span class="result-score"></span>
							<span class="result-text"></span>
						</div>
					</div>
				</div>

				{# Game actions — only one is visible at a time. Managed by guigameactions.ts #}
				<div class="game-actions unselectable">
					{# Live-only actions (actions-live + the incoming draw-offer prompt) #}
					{% if not meta.result and gamePageData.role is defined %}
					{# Default live-game actions: offer draw + resign/abort. Visible during live play. #}
					<div class="actions-live{{ '' if gamePageData.isLive else ' hidden' }}">
						<button class="action-btn tooltip-d" id="btn-offer-draw" data-tooltip="Offer draw"{% if not meta.resignable %} disabled{% endif %}>
							<svg class="action-icon" viewBox="0 0 24 24" fill="currentColor"><text x="6" y="2" font-family="sans-serif" font-size="18" font-weight="bold" text-anchor="middle" dominant-baseline="hanging">1</text><polygon points="15.375,2 17.875,2 7.875,22 5.375,22"/><text x="18" y="21.67" font-family="sans-serif" font-size="18" font-weight="bold" text-anchor="middle" dominant-baseline="alphabetic">2</text></svg>
						</button>
						{# Resign / Abort share one slot (mutually exclusive) #}
						<button class="action-btn tooltip-d{{ '' if not meta.resignable else ' hidden'}}" id="btn-abort" data-tooltip="Abort">
							<svg class="action-icon" viewBox="0 0 24 24"><use href="#svg-x"/></svg>
						</button>
						<button class="action-btn tooltip-d{{ '' if meta.resignable else ' hidden'}}" id="btn-resign" data-tooltip="Resign">
							<svg class="action-icon" viewBox="0 0 24 24"><use href="#svg-flag"/></svg>
						</button>
					</div>
					{# Incoming draw offer #}
					<div class="actions-draw-offer hidden">
						<span class="draw-offer-label">Accept draw offer?</span>
						<div class="draw-offer-buttons">
							<button class="action-btn" id="btn-accept-draw">
								<svg class="action-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
							</button>
							<button class="action-btn" id="btn-reject-draw"><svg class="action-icon"><use href="#svg-x"/></svg></button>
						</div>
					</div>
					{% endif %}
					{# Post-game actions: rematch, analysis board, and full computer review. #}
					<div class="actions-over{{ '' if meta.result else ' hidden' }}">
						{% if gamePageData.isLive and gamePageData.role is defined %}
						<button class="action-btn" id="btn-rematch">Rematch</button>
						{% endif %}
						<button class="action-btn" id="btn-analysis">Analysis</button>
						<button class="action-btn" id="btn-game-review">Game Review</button>
					</div>
				</div>

				{# Opponent-disconnect status — live-only static skeleton; omitted entirely once the game
				   is over (an opponent can't disconnect or be claimed against in a concluded game), so
				   it won't be found on a game that loaded concluded. Starts `.hidden`: the client reveals/
				   hides the block as the opponent drops/returns and writes the live countdown into
				   `.disconnect-text`, then reveals `.disconnect-buttons` (also `.hidden`) on expiry. #}
				{% if not meta.result %}
				<div class="disconnect-status hidden">
					<span class="disconnect-text">Opponent disconnected. You can claim victory in 10 seconds.</span>
					<div class="disconnect-buttons hidden">
						<button class="action-btn" id="btn-claim-victory">Claim victory</button>
						<button class="action-btn" id="btn-claim-draw">Call a draw</button>
					</div>
				</div>
				{% endif %}

				{# Bottom username container — SSR-OWNED (near side: you, or white for spectators).
				   Username/rating + clock are SSR'd; the client writes the live clock value, `tempo`,
				   and `eloChange`. #}
				<div class="player-bar" id="player-bar-bottom">
					{{ usernameEmbed(meta.players[meta.bars.bottom].name, meta.players[meta.bars.bottom].elo) }}
					<span class="clock{{ '' if meta.timed else ' hidden' }}"></span>
				</div>

			</div>{# .match-panel #}

			{# Bottom side's captured material
			   Bottom = you (player view) or white (spectator view). #}
			<div class="material" id="material-bottom">
				{# EXAMPLE #}
				{# <svg class="material-piece"><use href="#svg-pawn"/></svg> #}
				{# /EXAMPLE #}
			</div>

		</div>{# .play-group #}

		{# Chat window — participant-only #}
		{% if gamePageData.role is defined %}
		<div class="chat panel">
			{# The client toggles `.collapsed` on the .chat panel. #}
			<div class="chat-bar">
				<button class="btn-bare chat-toggle" id="btn-toggle-chat">
					<svg class="chat-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
					<span class="chat-title">Chat</span>
				</button>
				<button class="btn-bare icon-btn tooltip-d" id="btn-report" title="Report the chat">
					<svg><use href="#svg-flag"/></svg>
				</button>
			</div>
			<div class="chat-log scrollbar-thin">
				{# EXAMPLE — the client renders chat messages and static event notifications here.
				   The two notices below show the static-notification shape (draw/rematch offers & rejections, no buttons). #}
				{# <div class="chat-notice">Opponent offered a draw.</div>
				<div class="chat-notice">Draw offer declined.</div> #}
			</div>
			{# Chat input — the client disables/hides it for guests in non-friend games. #}
			<input class="chat-input" type="text" placeholder="Please be nice!" id="chat-input" />
		</div>
		{% endif %}

	</aside>

	{# Board canvas #}
	<div class="canvas-container bg-checkerboard-dimmed">
		{# The background is visible until the client reveals the canvas when the game is fully loaded #}
		<canvas class="board-canvas visibility-hidden" id="board-canvas"></canvas>
		{# Promotion UI #}
		<div id="promote" class="hidden">
			<div id="promote-white" class="promotecolor hidden"></div>
			<div id="promote-black" class="promotecolor hidden"></div>
		</div>
	</div>
</main>
{% endblock %}

{% block script %}
<script type="module" src="{{ manifest['scripts/esm/views/game/game.ts'] }}"></script>
{% endblock %}
