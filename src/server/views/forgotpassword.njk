{% extends "layout.njk" %}

{% set t = templateT('forgotpassword') %}
{% set pageName = t.form.title %}

{% block bodyClass %}sticky-footer{% endblock %}

{# No page-specific stylesheet: only uses shared rules from global.css. #}

{% block body %}
{% include "components/header/header.njk" %}

<main class="bg-checkerboard page-centered">
	{# Semi-opaque dark overlay sits above the checkerboard background, below all page content #}
	<div id="bg-overlay"></div>

	<form class="auth-card" id="forgot-form">
		<h1 class="auth-title">{{ t.form.title }}</h1>

		<p class="auth-prompt center">{{ t.form.prompt }}</p>

		<div class="auth-field">
			<label for="email">{{ t.form.email_label }}</label>
			{# maxlength 320: the email max length from validateEmail() in validators.ts. #}
			<input class="auth-input" type="email" id="email" name="email" autocomplete="email" autocapitalize="off" maxlength="320" required />
			{# Populated by forgotpassword.ts on a failed format check, server error, or network error. #}
			<p class="auth-error hidden" id="forgot-error"></p>
			<button class="btn-primary auth-field-submit" type="submit" id="forgot-submit">{{ t.form.submit }}</button>
		</div>
	</form>

	{# Swapped in by forgotpassword.ts (replacing the form) after a successful request. #}
	<div class="auth-card hidden" id="forgot-confirmation">
		<h1 class="auth-title">
			<svg class="glyph" viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>
			{{ t.confirmation.title }}
		</h1>
		<p class="auth-prompt center">{{ t.confirmation.body }}</p>
		<p class="auth-prompt center"><a class="auth-link" href="/login">{{ t.confirmation.back_to_login }}</a></p>
	</div>
</main>

{% include "components/footer/footer.njk" %}
{% endblock %}

{% block script %}
<script type="module" src="{{ manifest['scripts/esm/views/forgotpassword.ts'] }}"></script>
{% endblock %}
