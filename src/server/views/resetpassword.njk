{% extends "layout.njk" %}

{% from "components/forms.njk" import passwordInput %}

{% set t = templateT('resetpassword') %}
{% set pageName = t.form.title %}

{% block bodyClass %}sticky-footer{% endblock %}

{# No page-specific stylesheet: only uses shared rules from global.css. #}

{% block head %}
{# Ship the resetpassword [script] strings to the browser, preserving window.t from layout.njk. #}
<script>window.t = Object.assign(window.t || {}, { resetpassword: {{ scriptT('resetpassword') | json | safe }} });</script>
{% endblock %}

{% block body %}
{% include "components/header/header.njk" %}

<main class="bg-checkerboard page-centered">
	{# Semi-opaque dark overlay sits above the checkerboard background, below all page content #}
	<div id="bg-overlay"></div>

	{% if state == 'valid' %}
	{# Valid token → the set-new-password #}
	<form class="auth-card" id="reset-form">
		<h1 class="auth-title">{{ t.form.title }}</h1>
		<div class="auth-field">
			<label for="new-password">{{ t.form.new_password_label }}</label>
			{{ passwordInput("new-password", "new-password", "new-password") }}
			{# Populated by resetpassword.ts on a failed format check, server error, or network error. #}
			<p class="auth-error hidden" id="reset-error"></p>
			<button class="btn-primary auth-field-submit" type="submit" id="reset-submit" disabled>{{ t.form.submit }}</button>
		</div>
	</form>
	{% else %}
	{# Invalid/expired token → a dead-link message with a path to request a fresh link. #}
	<section class="auth-card" id="reset-invalid">
		<h1 class="auth-title">
			<svg class="glyph" viewBox="0 0 24 24"><path d="M6 6 18 18M18 6 6 18"/></svg>
			{{ t.expired.title }}
		</h1>
		<p class="auth-prompt center">{{ t.expired.body }}</p>
		<p class="auth-prompt center"><a class="auth-link" href="/forgot-password">{{ t.expired.request_new_link }}</a></p>
	</section>
	{% endif %}
</main>

{% include "components/footer/footer.njk" %}
{% endblock %}

{% block script %}
<script type="module" src="{{ manifest['scripts/esm/views/resetpassword.ts'] }}"></script>
{% endblock %}
