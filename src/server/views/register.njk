{% extends "layout.njk" %}

{% from "components/forms.njk" import passwordInput, textInput %}

{% set t = templateT('register') %}
{% set pageName = t.title %}

{% block bodyClass %}sticky-footer{% endblock %}

{# No page-specific stylesheet: only uses shared rules from global.css. #}

{% block head %}
{# Ship the register [script] strings to the browser, preserving window.t from layout.njk. #}
<script>window.t = Object.assign(window.t || {}, { register: {{ scriptT('register') | json | safe }} });</script>
{% endblock %}

{% block body %}
{% include "components/header/header.njk" %}

<main class="bg-checkerboard-dimmed page-centered">

	<form class="auth-card" id="register-form">
		<h1 class="auth-title">{{ t.title }}</h1>

		<div class="auth-field">
			<label for="username">{{ t.username_label }}</label>
			{{ textInput("username", "username", "text", "username", maxLengths.USERNAME) }}
			{# Populated by register.ts on a failed format / availability check. #}
			<p class="auth-error hidden" id="username-error"></p>
		</div>

		<div class="auth-field">
			<label for="password">{{ t.password_label }}</label>
			{{ passwordInput("password", "password", "new-password", maxLengths.PASSWORD) }}
			<p class="auth-error hidden" id="password-error"></p>
		</div>

		<div class="auth-field">
			<label for="email">{{ t.email_label }}</label>
			{{ textInput("email", "email", "email", "email", maxLengths.EMAIL) }}
			<p class="auth-error hidden" id="email-error"></p>
		</div>

		{# Populated by register.ts on a failed submit (server validation / conflict). #}
		<p class="auth-error center hidden" id="register-error"></p>

		{# Cloudflare Turnstile humanc-check #}
		<div id="turnstile-widget" class="turnstile-widget" data-sitekey="{{ turnstileSiteKey }}"></div>

		{% set termsLink %}<a class="auth-link" href="/terms" target="_blank">{{ t.terms_link }}</a>{% endset %}
		{% set privacyLink %}<a class="auth-link" href="/privacy" target="_blank">{{ t.privacy_link }}</a>{% endset %}
		<p class="auth-prompt">{{ t.terms_agreement | replace("{terms}", termsLink) | replace("{privacy}", privacyLink) | safe }}</p>

		<button class="btn-primary" type="submit" id="register-submit" disabled>{{ t.submit }}</button>

		<p class="auth-prompt center">{{ t.login_prompt }} <a class="auth-link" href="/login">{{ t.login_link }}</a></p>
	</form>
</main>

{% include "components/footer/footer.njk" %}
{% endblock %}

{% block script %}
<script type="module" src="{{ manifest['scripts/esm/views/register.ts'] }}"></script>
{# Runs logically after the module above, so register.ts assigns window.onloadTurnstileCallback before Turnstile's API invokes it. #}
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=onloadTurnstileCallback" defer></script>
{% endblock %}
