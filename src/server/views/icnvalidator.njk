{% extends "layout.njk" %}

{# Developer-only page, linked from nowhere on the site — its English is hardcoded on purpose, not translated. #}

{% set pageName = "ICN Validator" %}

{% block bodyClass %}sticky-footer{% endblock %}

{% block style %}
<link rel="stylesheet" href="{{ manifest['css/icnvalidator.css'] }}" />
{% endblock %}

{% block head %}
<script>window.$icnValidatorWorkerUrl = "{{ manifest['scripts/esm/views/icnvalidator/icnvalidator.worker.ts'] }}";</script>
{% endblock %}

{% block body %}
{% include "components/header/header.njk" %}
<main>
	<div class="container">
		<h1>ICN Validator (Developer Tool)</h1>
		<p>
			Checks the games output of an Apeiron engine SPRT run against the website's own chess
			logic. Every game's ICN is replayed through the site's move generator and game-end
			detection. Any disagreement (a parse failure, an illegal move, or a mismatched
			conclusion) is a bug in either the engine or the website.
		</p>

		<div class="upload-section" id="upload-section">
			<h2>Upload JSON File</h2>
			<p>Click to select, or drag and drop a JSON file containing an array of game notations.</p>
			<label for="file-input" class="file-label">Choose File</label>
			<input type="file" id="file-input" accept=".json" />
			<p class="file-name" id="file-name"></p>
		</div>

		<div class="progress-section" id="progress-section">
			<h2>Processing...</h2>
			<div class="progress-bar">
				<div class="progress-fill" id="progress-fill">0%</div>
			</div>
			<p id="progress-text">Processing game 0 of 0</p>
		</div>

		<div class="summary-section" id="summary-section">
			<h2>Validation Summary</h2>
			<div class="summary-hero">
				<div class="hero-stat">
					<span class="hero-value" id="pass-ratio">0 / 0</span>
					<span class="hero-label">GAMES PASSED</span>
				</div>
				<div class="hero-divider"></div>
				<div class="hero-stat">
					<span class="hero-value" id="pass-percentage">0%</span>
					<span class="hero-label">SUCCESS RATE</span>
				</div>
			</div>
			<div class="stat-grid">
				<div class="stat-card">
					<h3>ICN Converter Errors</h3>
					<p class="stat-value warning" id="icnconverter-errors">0</p>
				</div>
				<div class="stat-card">
					<h3>Formulator Errors</h3>
					<p class="stat-value error" id="formulator-errors">0</p>
				</div>
				<div class="stat-card">
					<h3>Illegal Move Errors</h3>
					<p class="stat-value error" id="illegal-move-errors">0</p>
				</div>
				<div class="stat-card">
					<h3>Termination Mismatch</h3>
					<p class="stat-value error" id="termination-mismatch-errors">0</p>
				</div>
			</div>
		</div>

		<div class="details-section" id="variant-section">
			<h2>Errors by Variant</h2>
			<div class="variant-stats" id="variant-stats"></div>
		</div>

		<div class="details-section" id="errors-section">
			<h2>Error Details</h2>
			<div class="error-list" id="error-list"></div>
		</div>

		<div class="log-section">
			<h2>Activity Log</h2>
			<div class="log-output" id="log-output"></div>
		</div>
	</div>
</main>
{% include "components/footer/footer.njk" %}
{% endblock %}

{% block script %}
<script type="module" src="{{ manifest['scripts/esm/views/icnvalidator/icnvalidator.ts'] }}"></script>
{% endblock %}
