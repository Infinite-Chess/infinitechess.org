{# The password-changed security receipt: confirmation line, and a warning linking to a password reset. #}
{% extends "emails/user/layout.njk" %}

{% block content %}
<p style="margin:0 0 16px;color:#444444;font-size:16px;line-height:1.6;">{{ body }}</p>
{% set resetLink %}<a href="{{ resetUrl }}" target="_blank" style="color:{{ accentColor }};text-decoration:underline;">{{ resetLinkText }}</a>{% endset %}
<p style="margin:0;color:#777777;font-size:13px;line-height:1.6;">{{ warning | replace("{resetLink}", resetLink) | safe }}</p>
{% endblock %}
